-- Hybrid Job Titles: shows one title for a character's two jobs (Knight + White Mage -> Paladin).
-- Generated by tools/build.py from data/job-titles.json; edit those, not this file.
-- Detours one CALL in the game's shared "Job/Job" formatter (party menu, license board header, job screen).
-- Pinned to Steam 1.0.4.0 at image base 0x120000; any other build is left untouched.
local SITE, CONTINUATION, LOOKUP = @SITE@, @CONTINUATION@, @LOOKUP@
local ORIGINAL = @ORIGINAL@
local STUB = @STUB@
local IMM = @IMM@
local NAMES = @NAMES@
local SLOTS = @SLOTS@ -- jobA*12+jobB -> NAMES index

local function bytes(value)
  if type(value) == 'string' then
    local t = {}; for i = 1, #value do t[i] = value:byte(i) end; return t
  end
  return value
end
local function same(a, b)
  if type(a) ~= 'table' or #a ~= #b then return false end
  for i = 1, #b do if a[i] ~= b[i] then return false end end
  return true
end
local function le(value, n)
  local t = {}; for i = 1, n do t[i] = value & 255; value = value >> 8 end; return t
end
local function write(address, data)
  assert(memory.writeArray(address, data) == true, 'write failed')
  assert(same(bytes(memory.readArray(address, #data)), data), 'write verification failed')
end

local installed = false
local function install()
  if installed then return end
  assert(same(bytes(memory.readArray(0x120000, 2)), {77, 90}), 'game not mapped at 0x120000')
  local current = bytes(memory.readArray(SITE, 5))
  if current[1] == 0xE9 then installed = true; return end -- already detoured (script reloaded)
  assert(same(current, ORIGINAL), 'unsupported game version (hook site differs)')

  -- Names, then a 144-entry pointer table (zero = no title, use the native label).
  local size = 144 * 8
  for _, n in ipairs(NAMES) do size = size + #n end
  local data = memory.alloc(size)
  assert(math.type(data) == 'integer' and data > 0, 'alloc failed')
  local table_ = data
  local cursor, addresses = data + 144 * 8, {}
  for i, n in ipairs(NAMES) do write(cursor, n); addresses[i] = cursor; cursor = cursor + #n end
  local pointers = {}
  for slot = 0, 143 do
    local p = SLOTS[slot] and addresses[SLOTS[slot]] or 0
    for _, b in ipairs(le(p, 8)) do pointers[#pointers + 1] = b end
  end
  write(table_, pointers)

  local stub = {}; for i, b in ipairs(STUB) do stub[i] = b end
  local function put(name, value) for i, b in ipairs(le(value, 8)) do stub[IMM[name] + i] = b end end
  put('table', table_); put('lookup', LOOKUP); put('cont1', CONTINUATION); put('cont2', CONTINUATION)
  local code = memory.allocExe(#stub)
  assert(math.type(code) == 'integer' and code > 0, 'allocExe failed')
  write(code, stub)

  local rel = code - (SITE + 5)
  assert(rel >= -0x80000000 and rel < 0x80000000, 'detour out of rel32 reach')
  local jmp = {0xE9}; for _, b in ipairs(le(rel & 0xFFFFFFFF, 4)) do jmp[#jmp + 1] = b end
  write(SITE, jmp)
  installed = true
  print('Hybrid Job Titles: installed')
end

local function try()
  local ok, why = pcall(install)
  if not ok then print('Hybrid Job Titles: not installed (' .. tostring(why) .. ')') end
end
try()
if not installed then event.registerEventAsync('onInitDone', try) end
